# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul

# Rust/Anchor build artifacts (keep IDL for frontend)
/target/*
!/target/idl/
/target/deploy/*.so

# Anchor keypairs (NEVER commit private keys)
*-keypair.json

# Claude local files
.claude/agents/
.claude/settings.local.json

# Noir/Barretenberg artifacts
/circuits/target/
/circuits/*/target/
*.proof
*.witness
*.gz
proof
vk
vk_hash
public_inputs
Verifier.toml
Prover.toml

# Solana verifier build artifacts (large binary files)
solana-verifiers/*.so
solana-verifiers/*-keypair.json
solana-verifiers/target/*.pk
solana-verifiers/target/*.vk
solana-verifiers/target/*.json
solana-verifiers/target/*.ccs
solana-verifiers/target/*.gz
